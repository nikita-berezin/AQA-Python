def print_products(*args):

    items = []

    for i in args:
        if type(i) == str and i != "":
            items.append(i)

    for i, item in enumerate(items, start=1):
        print(f"{i}) {item}")

    if len(items) == 0:
        print("Нет продуктов")
        return


print_products("хлеб", "хлеб", "0")
