class Product:
    def __init__(self, name, price):
        self.name = name
        self.price = price


class ShoppingCart:
    def __init__(self):
        self.basket = []

    def add_product(self, product, quantity=1):
        self.basket.append((product, quantity))

    def total(self):

        total_price = 0
        for product, quantity in self.basket:
            total_price += product.price * quantity
        return total_price

    def get_lines(self):

        lines = []
        for product, quanity in self.basket:
            cost = product.price * quanity
            lines.append(f"{product.name}: {product.price} x {quanity} = {cost}")
        return lines


def print_receipt(cart):

    for line in cart.get_lines():
        print(line)
    print(f"Итого: {cart.total()}")


apple = Product("Яблоко", 15)

cart = ShoppingCart()
cart.add_product(apple)
cart.add_product(apple, 3)

print_receipt(cart)
