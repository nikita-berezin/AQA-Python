class Wallet:
    def __init__(self):
        self._balance = 0

    @property
    def balance(self):
        return self._balance

    def deposit(self, amount):
        if amount > 0:
            self._balance += amount
            return True
        else:
            return False

    def spend(self, amount):
        if self._balance > 0 and amount <= self._balance:
            self._balance -= amount 
            return True
        else:
            return False
            

wallet = Wallet()
try:
    wallet.balance = 100
except AttributeError:
    print('Баланс нельзя присвоить напрямую')