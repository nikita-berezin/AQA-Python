def is_access_allowed(ip_address, mode, ip_access_lists):
    if mode == 1:
        # Режим 1: разрешено всё, что не в черном списке
        if ip_address in ip_access_lists["black list"]:
            return "НЕТ"
        else:
            return "ДА"

    elif mode == 2:
        # Режим 2: запрещено всё, что не в белом списке
        if ip_address in ip_access_lists["white list"]:
            return "ДА"
        else:
            return "НЕТ"


ip_address = "192.0.2.2"
mode = 2
ip_access_lists = {"black list": [], "white list": ["192.0.2.1"]}

print(is_access_allowed(ip_address, mode, ip_access_lists))
