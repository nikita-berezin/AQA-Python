def is_palindrome(text):

    text = text.lower()

    clean_text = ""

    for char in text:
        if char != " " and char not in ",.!?-":
            clean_text += char

    return clean_text == clean_text[::-1]


print(is_palindrome("А"))
print(is_palindrome("А-б-а!"))
print(is_palindrome("Привет, мир!"))
