n = int(input())
m = int(input())

found = False  # Флаг для отслеживания наличия решений

# Перебираем все возможные значения от 1 до n-1
for a in range(1, n):
    for b in range(1, n):
        for c in range(1, n):
            # Проверяем уравнение
            if a + 3 * b + 2 * c == m:
                # Выводим в точном соответствии с форматом задачи
                print(f"{a} + 3x{b} + 2x{c} = {m}")
                found = True

# Если после всех проверок флаг остался False
if not found:
    print("При заданных n и m решений не существует.")