# 1. Создаем словарь: ключ - символ, значение - [номер кнопки, количество нажатий]
keyboard = {
    '.': ['1', 1], ',': ['1', 2], '?': ['1', 3], '!': ['1', 4], ':': ['1', 5],
    'a': ['2', 1], 'b': ['2', 2], 'c': ['2', 3],
    'd': ['3', 1], 'e': ['3', 2], 'f': ['3', 3],
    'g': ['4', 1], 'h': ['4', 2], 'i': ['4', 3],
    'j': ['5', 1], 'k': ['5', 2], 'l': ['5', 3],
    'm': ['6', 1], 'n': ['6', 2], 'o': ['6', 3],
    'p': ['7', 1], 'q': ['7', 2], 'r': ['7', 3], 's': ['7', 4],
    't': ['8', 1], 'u': ['8', 2], 'v': ['8', 3],
    'w': ['9', 1], 'x': ['9', 2], 'y': ['9', 3], 'z': ['9', 4],
    ' ': ['0', 1]
}

# 2. Считываем текст и приводим к нижнему регистру
message = input().lower()

# 3. Создаем пустую строку для результата
result = ""

# 4. Перебираем каждый символ в сообщении
for char in message:
    # 5. Если символ есть в словаре (если нет - пропускаем)
    if char in keyboard:
        # Достаем номер кнопки и количество нажатий
        button = keyboard[char][0]
        presses = keyboard[char][1]
        
        # Добавляем к результату номер кнопки, повторенный нужное количество раз
        result += button * presses

# 6. Выводим результат
print(result)