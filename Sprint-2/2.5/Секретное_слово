text = input()
n = int(input())

dict1 = {}

for i in range(n):
    line = input()
    list1 = line.split(':')
    letter = list1[0].strip()
    digit = int(list1[1].strip())

    dict1[digit] = letter

result = ''

for char in text:
    text2 = text.count(char)
    result += dict1[text2]

print(result)