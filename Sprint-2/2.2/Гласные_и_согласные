s = input().lower()  # Сразу переводим всё в нижний регистр

vowels = "ауоыиэяюе"  # Строка с гласными 
consonants = "бвгджзйклмнпрстфхцчшщ" # Строка с согласными

v_count = 0  # Счетчик гласных
c_count = 0  # Счетчик согласных

for i in range(len(s)):
    if s[i] in vowels:       # Если символ по индексу i есть в строке гласных
        v_count += 1
    elif s[i] in consonants: # Иначе, если он есть в строке согласных
        c_count += 1

print(f"Количество гласных букв равно {v_count}")
print(f"Количество согласных букв равно {c_count}")